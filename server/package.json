{
  "name": "studyai-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/app.ts",
    "start": "tsx src/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gemini": "tsx scripts/test-gemini.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
