{
  "name": "pdf2learn-desktop",
  "productName": "Pdf2Learn",
  "version": "0.1.0",
  "private": true,
  "description": "Pdf2Learn: học giáo trình PDF với lộ trình bám sát sách, bài giảng có kiểm chứng và bản dịch tiếng Việt",
  "main": "desktop/main.cjs",
  "scripts": {
    "build:client": "npm run build --prefix client",
    "start": "node desktop/run.cjs",
    "dev": "npm run build:client && node desktop/run.cjs",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/stage.mjs && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
