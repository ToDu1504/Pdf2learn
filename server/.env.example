PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=studyai
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50


# Tốc độ xử lý: số lời gọi Gemini cùng lúc, số chương xử lý song song, mức suy nghĩ (minimal|low|high|default)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_CONCURRENCY=3
CHAPTER_CONCURRENCY=2
GEMINI_THINKING=low

# Dịch PDF giữ bố cục: thư mục clone VI-Translate (xem README). Không có thì tab Bản dịch dùng Gemini dịch chữ.
VI_TRANSLATE_DIR=../vi-translate
# Trình duyệt dùng để dịch qua Google (giải CAPTCHA trong cửa sổ này): chrome | edge | brave | coccoc | firefox
TRANSLATE_BROWSER=chrome
